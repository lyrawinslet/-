# 行尾策略：仓库内统一存 LF；批处理文件检出为 CRLF，shell 启动脚本保持 LF
* text=auto
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.command text eol=lf
*.sh      text eol=lf
*.py      text eol=lf

# 按二进制处理，避免 Git 做行尾/编码转换
*.xlsx binary
*.xls  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.gz   binary
*.zip  binary
